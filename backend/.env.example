# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://drivestock:drivestock_dev@localhost:5432/drivestock
TEST_DATABASE_URL=postgresql+psycopg://drivestock:drivestock_dev@localhost:5432/drivestock_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Access tokens are short-lived; sessions continue through a 30-day refresh-token cookie.
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Secure cookies need https; unset, they're on everywhere except APP_ENV=development.
# COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173
# 'development' enables local-only conveniences (seed-demo-users). Defaults to production.
APP_ENV=development
